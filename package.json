{
  "name": "thug2-thaw-level-converter",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "THUG2 THAW Level Converter: Tony Hawk's American Wasteland (PC) levels converted to Tony Hawk's Underground 2's formats.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CanuckAussieKev/thug2-thaw-level-converter.git"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./thaw/node_flags.ts": {
      "types": "./thaw/node_flags.ts",
      "default": "./thaw/node_flags.js"
    },
    "./thaw/thaw.ts": {
      "types": "./thaw/thaw.ts",
      "default": "./thaw/thaw.js"
    },
    "./thaw/thaw_scripts.ts": {
      "types": "./thaw/thaw_scripts.ts",
      "default": "./thaw/thaw_scripts.js"
    },
    "./thaw_levels/thaw_levels.ts": {
      "types": "./thaw_levels/thaw_levels.ts",
      "default": "./thaw_levels/thaw_levels.js"
    },
    "./package.json": "./package.json"
  },
  "commands": [
    "thaw_levels/migrate_layouts.ts",
    "thaw_levels/thaw_levels.ts",
    "thaw_levels/thugpro_compare.ts",
    "thaw_levels/thugpro_inventory.ts"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "node --test \"**/*.test.ts\""
  },
  "dependencies": {
    "thug2-level-converter-core": "git+https://git@github.com/CanuckAussieKev/thug2-level-converter-core.git#3f7390a5f224cd1c71fcec8077284961dc3610be",
    "thug2-thugpro-compat": "git+https://git@github.com/CanuckAussieKev/thug2-thugpro-compat.git#ca72ba8ed6dcdfddb18d4062b0c756516ac44068"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
